    "md": "0 6px 20px rgba(46,25,20,.14)",
    "lg": "0 20px 50px rgba(46,25,20,.22)"
  },
  "movimiento": {
    "rapido": "120ms",
    "base": "220ms",
    "lento": "420ms",
    "curva": "cubic-bezier(.2,.8,.2,1)",
    "rebote": "cubic-bezier(.34,1.56,.64,1)",
    "escena": "800ms",
    "texto": "700ms",
    "escalonado": "90ms",
    "cifra": "1200ms",
    "latido": "900ms",
    "cinta": "24s",
    "curva-escena": "cubic-bezier(.65,0,.35,1)"
  },
  "escena": {
    "$descripcion": "Escena 3D de la presentación (sudadera clay). Valores para Three.js: intensidades de luz, material y render. Los colores salen de color.presentacion y los colorways apuntan a tokens de color.",
    "material": {
      "rugosidad": 0.92,
      "metalico": 0,
      "brillo-tela": 0.55,
      "brillo-tela-rugosidad": 0.8
    },
    "luz": {
      "principal": 2.4,
      "relleno": 0.6,
      "contorno": 1.4,
      "ambiente": 0.5
    },
    "sombra-contacto": {
      "opacidad": 0.35,
      "escala": 1.6
    },
    "grano": {
      "opacidad": 0.05
    },
    "render": {
      "escala-maxima": 1.5,
      "fps-objetivo": 60
    },
    "layout": {
      "columnas-texto": 5,
      "columnas-escena": 7
    },
